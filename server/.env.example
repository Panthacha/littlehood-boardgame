# Copy this file to .env for local development (never commit the real .env).

# Admin dashboard password (used by the 'adminLogin' socket event).
# Required in production — the server falls back to a default and warns if unset.
ADMIN_PASSWORD=

# Optional: enables saving game history (final scores per finished round) to
# Supabase. Leave both blank to run without a database — the live game still
# works, it just won't remember past rounds. Create the project at
# supabase.com, then run server/sql/schema.sql in its SQL editor, then copy
# these from Project Settings > API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
